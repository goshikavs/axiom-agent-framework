{
  "name": "goshikq-agent-framework",
  "private": true,
  "version": "0.1.0-alpha",
  "description": "Goshikq monorepo JavaScript workspace (Studio + TypeScript SDK)",
  "workspaces": [
    "apps/studio",
    "sdk/typescript",
    "examples/typescript-refund-agent",
    "examples/typescript-mcp-agent",
    "examples/mcp-inventory-server",
    "templates/typescript-agent",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter @goshikq/studio dev",
    "studio": "bun --filter @goshikq/studio dev",
    "test": "bun --filter @goshikq/sdk test",
    "typecheck": "bun --filter @goshikq/sdk typecheck",
    "build": "bun --filter @goshikq/sdk typecheck"
  }
}
