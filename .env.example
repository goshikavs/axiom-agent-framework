# ---------------------------------------------------------------------------
# Goshikq local development configuration
# Copy to `.env` and adjust. Never commit `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL connection used by the Rust runtime (goshikq-server) and migrations.
# `embedded` downloads a local PostgreSQL into `.goshikq/postgres` (no Docker required).
# An existing `.axiom/postgres` cluster is reused (password/database remain `axiom`).
# docker-compose.yml provisions `postgres://goshikq:goshikq@127.0.0.1:5432/goshikq`.
# Unset GOSHIKQ_* names still fall back to the matching AXIOM_* variable.
DATABASE_URL=embedded
# GOSHIKQ_EMBEDDED_PG_PORT=55432
# GOSHIKQ_EMBEDDED_PG_TIMEOUT_SECS=180
# GOSHIKQ_EMBEDDED_PG_DIR=.goshikq/postgres

# Address the runtime API binds to. Keep loopback for local development.
# Binding to a non-loopback address requires GOSHIKQ_AUTH_MODE=api_key
# (or GOSHIKQ_ALLOW_INSECURE_BIND=true, which is unsafe outside isolated networks).
GOSHIKQ_BIND=127.0.0.1:7400

# Authentication mode for the runtime API:
#   none     — local single-user (loopback only unless GOSHIKQ_ALLOW_INSECURE_BIND=true)
#   api_key  — service identities (hashed keys in PostgreSQL)
#   oidc     — production users (JWT + JWKS issuer/audience validation). API keys still work as services.
GOSHIKQ_AUTH_MODE=none

# OIDC (required when GOSHIKQ_AUTH_MODE=oidc)
# GOSHIKQ_OIDC_ISSUER=https://idp.example.com/realms/goshikq
# GOSHIKQ_OIDC_AUDIENCE=goshikq
# GOSHIKQ_OIDC_JWKS_URL=https://idp.example.com/realms/goshikq/protocol/openid-connect/certs
# Loopback HMAC test tokens only:
# GOSHIKQ_OIDC_ALLOW_TEST_HMAC=true
# GOSHIKQ_OIDC_HMAC_SECRET=
# GOSHIKQ_OIDC_BOOTSTRAP_OWNER=alice

# JSON logs for production collectors.
# GOSHIKQ_LOG_FORMAT=json
# GOSHIKQ_RETENTION_DAYS=30
# Owner-only POST /api/v1/admin/retention/purge (dry_run defaults true)
# GOSHIKQ_WORKER_ATTACH_TIMEOUT_SECONDS=20
# Studio server-side API key (never expose to the browser).
# GOSHIKQ_STUDIO_API_KEY=

# Outbound OTLP/HTTP JSON for Goshikq's own execution spans (optional).
# Inbound POST /v1/traces is unchanged.
# GOSHIKQ_OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# GOSHIKQ_OTEL_TRACES_SAMPLER_ARG=1.0
# OTEL_SERVICE_NAME=goshikq-runtime

# JWKS cache TTL (seconds). Unknown kid always forces a refresh.
# GOSHIKQ_OIDC_JWKS_CACHE_SECONDS=300

# Allowed browser origins for the API (Studio dev server by default).
GOSHIKQ_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# How model input/output is persisted: `redacted` (default, secret patterns
# masked), `full`, or `none`.
GOSHIKQ_CAPTURE_MODEL_IO=redacted

# Path to the versioned model pricing table used for cost estimates.
GOSHIKQ_PRICING_FILE=config/pricing.json

# Log filter for the runtime (tracing-subscriber EnvFilter syntax).
RUST_LOG=info,goshikq_server=debug,goshikq_runtime=debug

# ---------------------------------------------------------------------------
# SDK / Studio
# ---------------------------------------------------------------------------

# Runtime endpoint used by the Python SDK, the TypeScript SDK and the CLI.
GOSHIKQ_RUNTIME_URL=http://127.0.0.1:7400

# API key sent by SDKs/CLI when GOSHIKQ_AUTH_MODE=api_key.
# GOSHIKQ_API_KEY=

# Studio (Next.js) server-side proxy target. The browser never talks to the
# runtime directly and never receives model provider credentials.
GOSHIKQ_STUDIO_RUNTIME_URL=http://127.0.0.1:7400

# ---------------------------------------------------------------------------
# Optional model provider credentials (only needed for real-model execution).
# The quickstart and all examples run with the deterministic mock model.
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
