# ---------------------------------------------------------------------------
# Axiom local development configuration
# Copy to `.env` and adjust. Never commit `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL connection used by the Rust runtime (axiom-server) and migrations.
# `embedded` downloads a local PostgreSQL into `.axiom/postgres` (no Docker required).
# docker-compose.yml provisions `postgres://axiom:axiom@127.0.0.1:5432/axiom`.
DATABASE_URL=embedded
# AXIOM_EMBEDDED_PG_PORT=55432
# AXIOM_EMBEDDED_PG_TIMEOUT_SECS=180
# AXIOM_EMBEDDED_PG_DIR=.axiom/postgres

# Address the runtime API binds to. Keep loopback for local development.
# Binding to a non-loopback address requires AXIOM_AUTH_MODE=api_key
# (or AXIOM_ALLOW_INSECURE_BIND=true, which is unsafe outside isolated networks).
AXIOM_BIND=127.0.0.1:7400

# Authentication mode for the runtime API:
#   none     — local single-user (loopback only unless AXIOM_ALLOW_INSECURE_BIND=true)
#   api_key  — service identities (hashed keys in PostgreSQL)
#   oidc     — production users (JWT + JWKS issuer/audience validation). API keys still work as services.
AXIOM_AUTH_MODE=none

# OIDC (required when AXIOM_AUTH_MODE=oidc)
# AXIOM_OIDC_ISSUER=https://idp.example.com/realms/axiom
# AXIOM_OIDC_AUDIENCE=axiom
# AXIOM_OIDC_JWKS_URL=https://idp.example.com/realms/axiom/protocol/openid-connect/certs
# Loopback HMAC test tokens only:
# AXIOM_OIDC_ALLOW_TEST_HMAC=true
# AXIOM_OIDC_HMAC_SECRET=
# AXIOM_OIDC_BOOTSTRAP_OWNER=alice

# JSON logs for production collectors.
# AXIOM_LOG_FORMAT=json
# AXIOM_RETENTION_DAYS=30
# Owner-only POST /api/v1/admin/retention/purge (dry_run defaults true)
# AXIOM_WORKER_ATTACH_TIMEOUT_SECONDS=20
# Studio server-side API key (never expose to the browser).
# AXIOM_STUDIO_API_KEY=

# Outbound OTLP/HTTP JSON for Axiom's own execution spans (optional).
# Inbound POST /v1/traces is unchanged.
# AXIOM_OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# AXIOM_OTEL_TRACES_SAMPLER_ARG=1.0
# OTEL_SERVICE_NAME=axiom-runtime

# JWKS cache TTL (seconds). Unknown kid always forces a refresh.
# AXIOM_OIDC_JWKS_CACHE_SECONDS=300

# Allowed browser origins for the API (Studio dev server by default).
AXIOM_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# How model input/output is persisted: `redacted` (default, secret patterns
# masked), `full`, or `none`.
AXIOM_CAPTURE_MODEL_IO=redacted

# Path to the versioned model pricing table used for cost estimates.
AXIOM_PRICING_FILE=config/pricing.json

# Log filter for the runtime (tracing-subscriber EnvFilter syntax).
RUST_LOG=info,axiom_server=debug,axiom_runtime=debug

# ---------------------------------------------------------------------------
# SDK / Studio
# ---------------------------------------------------------------------------

# Runtime endpoint used by the Python SDK, the TypeScript SDK and the CLI.
AXIOM_RUNTIME_URL=http://127.0.0.1:7400

# API key sent by SDKs/CLI when AXIOM_AUTH_MODE=api_key.
# AXIOM_API_KEY=

# Studio (Next.js) server-side proxy target. The browser never talks to the
# runtime directly and never receives model provider credentials.
AXIOM_STUDIO_RUNTIME_URL=http://127.0.0.1:7400

# ---------------------------------------------------------------------------
# Optional model provider credentials (only needed for real-model execution).
# The quickstart and all examples run with the deterministic mock model.
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
