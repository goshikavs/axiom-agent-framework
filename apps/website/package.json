{
  "name": "@goshikq/website",
  "private": true,
  "type": "module",
  "version": "0.1.0-alpha",
  "description": "Public Goshikq marketing and documentation website",
  "scripts": {
    "prepare:content": "node scripts/prepare.mjs",
    "dev": "node scripts/prepare.mjs && astro dev --host 127.0.0.1 --port 4321",
    "start": "node scripts/prepare.mjs && astro dev --host 127.0.0.1 --port 4321",
